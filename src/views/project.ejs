<%- include('partials/header') %>

<main class="project-details">
  <h1><%= project.title %></h1>

  <p><strong>Description:</strong></p>
  <p><%= project.description %></p>

  <p>
    <strong>Date:</strong>
    <%= new Date(project.date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    }) %>
  </p>

  <p>
    <strong>Location:</strong>
    <%= project.location %>
  </p>

  <p>
    <strong>Organization:</strong>
    <a href="/organization/<%= project.organization_id %>">
      <%= project.organization_name %>
    </a>
  </p>

  <p>
    <strong>Categories:</strong>
    <% categories.forEach(category => { %>
      <a class="category-tag" href="/category/<%= category.category_id %>">
    <%= category.name %>
      </a>
    <% }) %>
  </p>
    <% if (user) { %>

    <% if (!isVolunteer) { %>

      <form action="/project/<%= project.project_id %>/volunteer" method="POST">
        <button type="submit">
          Volunteer For This Project
        </button>
      </form>

    <% } else { %>

      <p>
        <strong>
          You are volunteering for this project.
        </strong>
      </p>

      <form action="/project/<%= project.project_id %>/remove-volunteer" method="POST">
        <button type="submit">
          Remove Volunteer Signup
        </button>
      </form>

    <% } %>

  <% } %>
   <% if (user && user.role_name === 'admin') { %>
  <a href="/assign-categories/<%= project.project_id %>" class="action-link">Edit Categories</a>
  <a href="/edit-project/<%= project.project_id %>" class="action-link">Edit Project</a>
  <% } %>
</main>

<%- include('partials/footer') %>