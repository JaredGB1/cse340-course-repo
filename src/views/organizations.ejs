<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <p>Here are a few of our partner organizations:</p>
    <ul class="organization-list">
        <% organizations.forEach(organization => { %>
            <li>
                <img
                    src="/images/<%= organization.logo_filename %>"
                    alt="<%= organization.name %> logo"
                >

                <div class="organization-info">
                    <a href="/organization/<%= organization.organization_id %>">
                    <strong><%= organization.name %></strong>
                    </a>

                    <p><%= organization.contact_email %></p>
                </div>
            </li>
        <% }); %>
    </ul>
    <p><a href="/new-organization" class="action-link">Add a new organization</a></p>
</main>

<%- include('partials/footer') %>
