<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <h2>Service Categories</h2>

  <ul class="card-list">
    <% categories.forEach(category => { %>
      <li>
        <a href="/category/<%= category.category_id %>">
          <strong><%= category.name %></strong>
        </a>
      </li>
    <% }); %>
  </ul>
</main>

<%- include('partials/footer') %>
