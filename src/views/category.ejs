<%- include('partials/header') %>

<main>
  <h1><%= category.name %></h1>

  <h2>Projects in this Category</h2>

  <% if (projects.length > 0) { %>
    <ul class="card-list">
      <% projects.forEach(project => { %>
        <li>
          <a href="/project/<%= project.project_id %>">
            <%= project.title %>
          </a>
        </li>
      <% }); %>
    </ul>
  <% } else { %>
    <p>No projects are currently assigned to this category.</p>
  <% } %>

  <p>
    <a href="/edit-category/<%= category.category_id %>" class="action-link">
        Edit Category
    </a>
  </p>
</main>

<%- include('partials/footer') %>