<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <h2>Upcoming Service Projects</h2>

  <ul class="project-list">
    <% projects.forEach(project => { %>
      <li>
        <%= new Date(project.date).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        }) %>:

        <a class="project-link" href="/project/<%= project.project_id %>">
          <%= project.title %>
        </a>

        (
        <a href="/organization/<%= project.organization_id %>">
          <%= project.organization_name %>
        </a>
        )
      </li>
    <% }) %>
  </ul>
  <p><% if (user && user.role_name === 'admin') { %> <a href="/new-project" class="action-link">Add a New Service Project</a> <% } %> </p>
</main>

<%- include('partials/footer') %>